@page "/inventario/ventas"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.SalesPosUse)]
@inject IProductCatalogQuery ProductQuery
@inject IStockQuery StockQuery
@inject PosSaleService SaleService
@inject ICurrentUser CurrentUser

<PageTitle>Registrar venta · TiendaFlow</PageTitle>

<PageHeader
    Eyebrow="Inventario"
    Title="Registrar venta"
    Subtitle="Agrega uno o varios productos, confirma la venta y se descuentan del stock en una sola operación" />

<div class="two-column">
    <section class="card">
        <h2>Datos de la venta</h2>

        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">@_error</div>
        }

        <div class="field">
            <label for="sale-sku">Producto</label>
            <select id="sale-sku" class="input" @bind="_sku">
                @foreach (var product in _products)
                {
                    <option value="@product.Sku">@product.Sku · @product.Name</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="sale-quantity">Cantidad</label>
            <input id="sale-quantity" type="number" min="1" class="input" @bind="_quantity" />
        </div>

        <dl class="summary-list">
            <div>
                <dt>Precio unitario</dt>
                <dd>@Formatters.Money(PriceOf(_sku))</dd>
            </div>
            <div>
                <dt>Disponible en @CurrentUser.StoreName</dt>
                <dd>@Formatters.Quantity(AvailableOf(_sku)) unidades</dd>
            </div>
        </dl>

        <div class="form-actions">
            <button id="sale-add" type="button" class="button button-secondary" disabled="@(AvailableOf(_sku) <= 0)" @onclick="AddToCart">
                + Agregar al carrito
            </button>
        </div>

        @if (_cart.Count > 0)
        {
            <div class="table-wrap">
                <table class="data-table cart-table">
                    <thead>
                        <tr><th>Producto</th><th class="num">Cantidad</th><th class="num">Subtotal</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _cart)
                        {
                            <tr>
                                <td>@NameOf(line.Sku) <span class="table-meta">@line.Sku</span></td>
                                <td class="num">@Formatters.Quantity(line.Quantity)</td>
                                <td class="num">@Formatters.Money(PriceOf(line.Sku) * line.Quantity)</td>
                                <td class="table-actions">
                                    <button type="button" class="button button-secondary button-small" @onclick="() => _cart.Remove(line)">Quitar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <dl class="summary-list">
            <div class="summary-total">
                <dt>Total</dt>
                <dd>@Formatters.Money(CartTotal)</dd>
            </div>
        </dl>

        <button type="button" class="button button-primary" disabled="@(_cart.Count == 0)" @onclick="RegisterSale">
            Confirmar venta
        </button>
    </section>

    <section class="card">
        <div class="card-header">
            <div>
                <h2>Comprobante</h2>
                <p class="card-subtitle">Última venta registrada en esta sesión; queda guardada en el reporte de ventas</p>
            </div>
        </div>

        @if (_receipt is null)
        {
            <EmptyState Title="Aún no hay ventas"
                        Message="Agrega productos al carrito y confirma la venta para ver aquí su comprobante." />
        }
        else
        {
            <div class="receipt">
                <div class="receipt-head">
                    <div>
                        <span class="receipt-code">@_receipt.Code · N.º @_receipt.SaleId</span>
                        <h3>@_receipt.Lines.Count producto(s)</h3>
                        <span class="table-meta">@Formatters.ShortDateTime(_receipt.SoldAt)</span>
                    </div>
                    <StatusBadge Text="Venta registrada" Tone="ok" />
                </div>

                <dl class="receipt-lines">
                    @foreach (var line in _receipt.Lines)
                    {
                        <div>
                            <dt>@line.ProductName × @Formatters.Quantity(line.Quantity)</dt>
                            <dd>@Formatters.Money(line.LineTotal)</dd>
                        </div>
                    }
                </dl>

                <div class="receipt-total">
                    <span>Total</span>
                    <strong>@Formatters.Money(_receipt.Total)</strong>
                </div>

                @foreach (var line in _receipt.CriticalLines)
                {
                    @* HU-05: the sale itself raises the critical stock alert. *@
                    <div class="alert alert-warning" role="alert">
                        Stock crítico: @line.ProductName quedó con @Formatters.Quantity(line.RemainingStock) unidades y
                        el mínimo es @Formatters.Quantity(line.MinStock). El producto ya aparece en las alertas de stock
                        para reponerlo.
                    </div>
                }

                <p class="receipt-footer">
                    Stock restante:
                    @string.Join(" · ", _receipt.Lines.Select(line => $"{line.ProductSku}: {line.RemainingStock}"))
                </p>
            </div>
        }
    </section>
</div>

@code {
    private IReadOnlyList<ProductListItem> _products = [];
    private IReadOnlyDictionary<string, StockRow> _stock = new Dictionary<string, StockRow>();
    private readonly List<PosCartLine> _cart = new();
    private PosCartReceipt? _receipt;
    private string _sku = string.Empty;
    private int _quantity = 1;
    private string? _error;

    private decimal CartTotal => _cart.Sum(line => PriceOf(line.Sku) * line.Quantity);

    private ProductListItem? ProductOf(string sku) =>
        _products.FirstOrDefault(product => string.Equals(product.Sku, sku, StringComparison.OrdinalIgnoreCase));

    private decimal PriceOf(string sku) => ProductOf(sku)?.SalePrice ?? 0m;

    private string NameOf(string sku) => ProductOf(sku)?.Name ?? sku;

    private int AvailableOf(string sku) =>
        (_stock.GetValueOrDefault(sku)?.QuantityAvailable ?? 0)
        - _cart.Where(line => string.Equals(line.Sku, sku, StringComparison.OrdinalIgnoreCase)).Sum(line => line.Quantity);

    protected override void OnInitialized()
    {
        try
        {
            _products = ProductQuery.Search(term: null);
            _sku = _products.FirstOrDefault()?.Sku ?? string.Empty;
            LoadStock();
        }
        catch (Exception exception)
        {
            _error = DomainErrorTranslator.ToSpanish(exception);
        }
    }

    private void AddToCart()
    {
        _error = null;

        if (_quantity <= 0)
        {
            _error = "La cantidad debe ser mayor que cero.";
            return;
        }

        if (_quantity > AvailableOf(_sku))
        {
            _error = "No hay unidades suficientes para completar la operación.";
            return;
        }

        var existing = _cart.FindIndex(line => string.Equals(line.Sku, _sku, StringComparison.OrdinalIgnoreCase));
        if (existing >= 0)
            _cart[existing] = _cart[existing] with { Quantity = _cart[existing].Quantity + _quantity };
        else
            _cart.Add(new PosCartLine(_sku, _quantity));

        _quantity = 1;
    }

    private void RegisterSale()
    {
        _error = null;

        try
        {
            _receipt = SaleService.RegisterCart(CurrentUser.StoreId ?? 0, _cart.ToList());
            _cart.Clear();
            LoadStock();
        }
        catch (Exception exception)
        {
            _error = DomainErrorTranslator.ToSpanish(exception);
        }
    }

    private void LoadStock() =>
        _stock = StockQuery.ListByStore(CurrentUser.StoreId ?? 0)
            .ToDictionary(row => row.Sku, StringComparer.OrdinalIgnoreCase);
}
