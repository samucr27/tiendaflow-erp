@page "/Error"
@layout MainLayout
@using System.Diagnostics

<PageTitle>Error · TiendaFlow</PageTitle>

<PageHeader
    Eyebrow="TiendaFlow"
    Title="Ocurrió un error"
    Subtitle="No pudimos completar la operación solicitada." />

<div class="alert alert-error" role="alert">
    Intenta de nuevo. Si el problema continúa, contacta al administrador del sistema.
</div>

@if (ShowRequestId)
{
    <p class="field-hint">
        Identificador de la solicitud: <code>@RequestId</code>
    </p>
}

<a class="button button-primary" href="inventario">Volver al panel</a>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
