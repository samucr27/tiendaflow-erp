@page "/seguridad/usuarios/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.SecurityUsersManage)]
@using System.ComponentModel.DataAnnotations
@inject UserService UserService
@inject UserDirectoryService UserDirectory
@inject IAccessControl AccessControl
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>Editar usuario · TiendaFlow</PageTitle>

<PageHeader Eyebrow="Seguridad / Usuarios"
            Title="@(_detail?.FullName ?? "Editar usuario")"
            Subtitle="@(_detail is null ? "Cargando…" : $"{_detail.Email} · {_detail.RoleLabel}")">
    <Actions>
        <a class="button button-secondary" href="seguridad/usuarios">Volver</a>
    </Actions>
</PageHeader>

@if (_success is not null)
{
    <div class="alert alert-success" role="status">@_success</div>
}
@if (_error is not null)
{
    <div class="alert alert-error" role="alert">@_error</div>
}

@if (_detail is null || _options is null || _form is null)
{
    <p class="muted">Cargando el usuario…</p>
}
else
{
    <section class="card">
        <div class="card-header">
            <div>
                <h2>Estado de la cuenta</h2>
                <p class="card-subtitle">
                    @(_detail.Active ? "La cuenta puede iniciar sesión." : "La cuenta está desactivada y no puede iniciar sesión.")
                </p>
            </div>
            <span class="badge @(_detail.Active ? "badge-success" : "badge-muted")">
                @(_detail.Active ? "Activo" : "Inactivo")
            </span>
        </div>

        @if (_detail.Active && _detail.Id != CurrentUser.UserId)
        {
            <button type="button" class="button button-danger" @onclick="Deactivate">Desactivar cuenta</button>
        }
        else if (_detail.Id == CurrentUser.UserId)
        {
            <p class="muted">No puedes desactivar tu propia cuenta.</p>
        }
    </section>

    <EditForm Model="_form" OnValidSubmit="Save" FormName="editar-usuario" class="form-card">
        <DataAnnotationsValidator />

        <div class="form-section">
            <h2>Datos de la persona</h2>

            <div class="form-grid">
                <div class="field">
                    <label for="edit-name">Nombre completo</label>
                    <InputText id="edit-name" class="input" @bind-Value="_form.FullName" />
                    <ValidationMessage For="() => _form.FullName" />
                </div>

                <div class="field">
                    <label for="edit-id-number">Número de documento</label>
                    <InputText id="edit-id-number" class="input" @bind-Value="_form.IdNumber" />
                    <ValidationMessage For="() => _form.IdNumber" />
                </div>

                <div class="field">
                    <label for="edit-position">Cargo</label>
                    <InputText id="edit-position" class="input" @bind-Value="_form.Position" />
                    <ValidationMessage For="() => _form.Position" />
                </div>

                <div class="field">
                    <label for="edit-email">Correo electrónico</label>
                    <InputText id="edit-email" class="input" type="email" @bind-Value="_form.Email" />
                    <ValidationMessage For="() => _form.Email" />
                </div>

                <div class="field">
                    <label for="edit-store">Tienda</label>
                    <InputSelect id="edit-store" class="input" @bind-Value="_form.StoreId">
                        @foreach (var store in _options.Stores)
                        {
                            <option value="@store.Id">@store.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="field">
                    <label for="edit-role">Rol</label>
                    <InputSelect id="edit-role" class="input" @bind-Value="_form.RoleId">
                        @foreach (var role in _options.Roles)
                        {
                            <option value="@role.Id">@SystemRoles.Label(role.Name)</option>
                        }
                    </InputSelect>
                </div>
            </div>

            @if (_detail.Id == CurrentUser.UserId)
            {
                <p class="muted">No puedes cambiar el estado de tu propia cuenta.</p>
            }
            else
            {
                <div class="field field-inline">
                    <InputCheckbox id="edit-active" @bind-Value="_form.Active" />
                    <label for="edit-active">Cuenta activa</label>
                </div>
            }
        </div>

        <div class="form-section">
            <h2>Restablecer contraseña</h2>
            <p class="card-subtitle">Déjala vacía para conservar la contraseña actual.</p>

            <div class="form-grid">
                <div class="field">
                    <label for="edit-password">Nueva contraseña</label>
                    <InputText id="edit-password" class="input" type="password" @bind-Value="_form.NewPassword" />
                    <ValidationMessage For="() => _form.NewPassword" />
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a class="button button-secondary" href="seguridad/usuarios">Cancelar</a>
            <button type="submit" class="button button-primary">Guardar cambios</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private UserDetail? _detail;
    private UserFormOptions? _options;
    private EditUserForm? _form;
    private string? _error;
    private string? _success;

    protected override void OnInitialized() => Load();

    private void Load()
    {
        try
        {
            _detail = UserDirectory.Get(Id);
            _options = UserDirectory.GetFormOptions();
            _form = new EditUserForm
            {
                FullName = _detail.FullName,
                IdNumber = _detail.IdNumber,
                Position = _detail.Position,
                Email = _detail.Email,
                StoreId = _detail.StoreId ?? 0,
                RoleId = _detail.RoleId,
                Active = _detail.Active
            };
        }
        catch (UserNotFoundException)
        {
            _error = "No encontramos el usuario solicitado.";
        }
        catch (AccessDeniedException)
        {
            Navigation.NavigateTo("/acceso-denegado");
        }
        catch (Exception exception)
        {
            _error = DomainErrorTranslator.ToSpanish(exception);
        }
    }

    private void Save()
    {
        _error = null;
        _success = null;

        try
        {
            UserService.UpdateUser(Id, new UpdateUserRequest(
                _form!.Email,
                _form.FullName,
                _form.IdNumber,
                _form.Position,
                _form.StoreId,
                _form.RoleId,
                _form.Active,
                string.IsNullOrWhiteSpace(_form.NewPassword) ? null : _form.NewPassword));

            _success = "Los cambios se guardaron correctamente.";
            _form.NewPassword = string.Empty;
            _detail = UserDirectory.Get(Id);
        }
        catch (AccessDeniedException)
        {
            Navigation.NavigateTo("/acceso-denegado");
        }
        catch (Exception exception)
        {
            _error = DomainErrorTranslator.ToSpanish(exception);
        }
    }

    private void Deactivate()
    {
        _error = null;
        _success = null;

        try
        {
            UserService.DeactivateUser(Id);
            _success = "La cuenta quedó desactivada.";
            _detail = UserDirectory.Get(Id);
        }
        catch (AccessDeniedException)
        {
            Navigation.NavigateTo("/acceso-denegado");
        }
        catch (Exception exception)
        {
            _error = DomainErrorTranslator.ToSpanish(exception);
        }
    }

    private sealed class EditUserForm
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(160, ErrorMessage = "El nombre no puede superar 160 caracteres.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "El documento es obligatorio.")]
        [StringLength(30, ErrorMessage = "El documento no puede superar 30 caracteres.")]
        public string IdNumber { get; set; } = string.Empty;

        [Required(ErrorMessage = "El cargo es obligatorio.")]
        [StringLength(100, ErrorMessage = "El cargo no puede superar 100 caracteres.")]
        public string Position { get; set; } = string.Empty;

        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Escribe un correo válido.")]
        public string Email { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Selecciona una tienda.")]
        public int StoreId { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Selecciona un rol.")]
        public int RoleId { get; set; }

        public bool Active { get; set; }

        [MinLength(8, ErrorMessage = "La contraseña debe tener al menos 8 caracteres.")]
        public string? NewPassword { get; set; }
    }
}
