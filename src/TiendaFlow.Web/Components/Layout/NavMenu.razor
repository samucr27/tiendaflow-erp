<div class="brand">
    <div class="brand-mark" aria-hidden="true">TF</div>
    <div class="brand-copy">
        <span class="brand-name">TiendaFlow</span>
        <span class="brand-sub">ERP para tiendas de conveniencia</span>
    </div>
</div>

<div class="sidebar-store">
    <span class="store-dot" aria-hidden="true"></span>
    <span>Tienda @DemoSession.StoreName</span>
</div>

<nav class="sidebar-nav" aria-label="Navegación principal">
    <p class="nav-section">Inventario</p>

    <NavLink class="nav-item" href="inventario" Match="NavLinkMatch.All">
        Panel de inventario
    </NavLink>
    <NavLink class="nav-item" href="inventario/productos" Match="NavLinkMatch.Prefix">
        Productos
    </NavLink>
    <NavLink class="nav-item" href="inventario/stock" Match="NavLinkMatch.Prefix">
        Consultar stock
    </NavLink>
    <NavLink class="nav-item" href="inventario/recibir" Match="NavLinkMatch.Prefix">
        Recibir mercancía
    </NavLink>
    <NavLink class="nav-item" href="inventario/ventas" Match="NavLinkMatch.Prefix">
        Registrar venta
    </NavLink>
    <NavLink class="nav-item" href="inventario/alertas" Match="NavLinkMatch.Prefix">
        Alertas de stock
    </NavLink>

    <p class="nav-section">Módulos</p>
    <span class="nav-item nav-item-disabled">Compras <small>Próximamente</small></span>
    <span class="nav-item nav-item-disabled">Talento humano <small>Próximamente</small></span>
    <span class="nav-item nav-item-disabled">Clientes <small>Próximamente</small></span>
    <span class="nav-item nav-item-disabled">Administración <small>Próximamente</small></span>
</nav>

<div class="sidebar-user">
    <div class="avatar" aria-hidden="true">MR</div>
    <div class="sidebar-user-copy">
        <span class="sidebar-user-name">@DemoSession.UserName</span>
        <span class="sidebar-user-role">@DemoSession.UserRole</span>
    </div>
</div>
