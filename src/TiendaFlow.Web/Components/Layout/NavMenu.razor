@inject ICurrentUser CurrentUser
@inject IAccessControl AccessControl

<div class="brand">
    <div class="brand-mark" aria-hidden="true">TF</div>
    <div class="brand-copy">
        <span class="brand-name">TiendaFlow</span>
        <span class="brand-sub">ERP para tiendas de conveniencia</span>
    </div>
</div>

<div class="sidebar-store">
    <span class="store-dot" aria-hidden="true"></span>
    <span>Tienda @CurrentUser.StoreName</span>
</div>

<nav class="sidebar-nav" aria-label="Navegación principal">
    @if (AccessControl.Has(Permissions.InventoryStockView)
         || AccessControl.Has(Permissions.InventoryProductsView))
    {
        <p class="nav-section">Inventario</p>

        @if (AccessControl.Has(Permissions.InventoryStockView))
        {
            <NavLink class="nav-item" href="inventario" Match="NavLinkMatch.All">
                Panel de inventario
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.InventoryProductsView))
        {
            <NavLink class="nav-item" href="inventario/productos" Match="NavLinkMatch.Prefix">
                Productos
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.InventoryStockView))
        {
            <NavLink class="nav-item" href="inventario/stock" Match="NavLinkMatch.Prefix">
                Consultar stock
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.InventoryStockReceive))
        {
            <NavLink class="nav-item" href="inventario/recibir" Match="NavLinkMatch.Prefix">
                Recibir mercancía
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.SalesPosUse))
        {
            <NavLink class="nav-item" href="inventario/ventas" Match="NavLinkMatch.Prefix">
                Registrar venta
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.InventoryAlertsView))
        {
            <NavLink class="nav-item" href="inventario/alertas" Match="NavLinkMatch.Prefix">
                Alertas de stock
            </NavLink>
        }
    }

    @if (AccessControl.Has(Permissions.InventoryReportsView)
         || AccessControl.Has(Permissions.SalesReportsView)
         || AccessControl.Has(Permissions.HrPayrollManage))
    {
        <p class="nav-section">Reportes</p>

        @if (AccessControl.Has(Permissions.InventoryReportsView))
        {
            <NavLink class="nav-item" href="reportes/inventario" Match="NavLinkMatch.Prefix">
                Inventario
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.SalesReportsView))
        {
            <NavLink class="nav-item" href="reportes/ventas" Match="NavLinkMatch.Prefix">
                Ventas
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.HrPayrollManage))
        {
            <NavLink class="nav-item" href="reportes/nomina" Match="NavLinkMatch.Prefix">
                Nómina
            </NavLink>
        }
    }

    @if (AccessControl.Has(Permissions.SecurityUsersView)
         || AccessControl.Has(Permissions.SecurityRolesView)
         || AccessControl.Has(Permissions.SecurityAuditView))
    {
        <p class="nav-section">Seguridad</p>

        @if (AccessControl.Has(Permissions.SecurityUsersView))
        {
            <NavLink class="nav-item" href="seguridad/usuarios" Match="NavLinkMatch.Prefix">
                Usuarios
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.SecurityRolesView))
        {
            <NavLink class="nav-item" href="seguridad/roles" Match="NavLinkMatch.Prefix">
                Roles y permisos
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.SecurityAuditView))
        {
            <NavLink class="nav-item" href="seguridad/auditoria" Match="NavLinkMatch.Prefix">
                Auditoría
            </NavLink>
        }
    }

    @if (AccessControl.Has(Permissions.HrEmployeesView)
         || AccessControl.Has(Permissions.HrPayrollManage))
    {
        <p class="nav-section">Talento humano</p>

        @if (AccessControl.Has(Permissions.HrEmployeesView))
        {
            <NavLink class="nav-item" href="rrhh/empleados" Match="NavLinkMatch.Prefix">
                Empleados
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.HrPayrollManage))
        {
            <NavLink class="nav-item" href="rrhh/nomina" Match="NavLinkMatch.Prefix">
                Nómina
            </NavLink>
        }
    }

    @if (AccessControl.Has(Permissions.PurchasingSuppliersView)
         || AccessControl.Has(Permissions.PurchasingOrdersView))
    {
        <p class="nav-section">Compras</p>

        @if (AccessControl.Has(Permissions.PurchasingSuppliersView))
        {
            <NavLink class="nav-item" href="proveedores" Match="NavLinkMatch.Prefix">
                Proveedores
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.PurchasingOrdersView))
        {
            <NavLink class="nav-item" href="compras/ordenes" Match="NavLinkMatch.Prefix">
                Órdenes de compra
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.PurchasingReportsView))
        {
            <NavLink class="nav-item" href="proveedores/ranking" Match="NavLinkMatch.Prefix">
                Ranking de proveedores
            </NavLink>
        }
    }

    @if (AccessControl.Has(Permissions.SalesInvoicesView))
    {
        <p class="nav-section">Facturación</p>

        <NavLink class="nav-item" href="facturacion" Match="NavLinkMatch.Prefix">
            Facturas
        </NavLink>
    }

    @if (AccessControl.Has(Permissions.CrmCustomersView)
         || AccessControl.Has(Permissions.CrmReportsView))
    {
        <p class="nav-section">CRM</p>

        @if (AccessControl.Has(Permissions.CrmCustomersView))
        {
            <NavLink class="nav-item" href="crm/clientes" Match="NavLinkMatch.Prefix">
                Clientes
            </NavLink>
        }
        @if (AccessControl.Has(Permissions.CrmReportsView))
        {
            <NavLink class="nav-item" href="crm/segmentacion" Match="NavLinkMatch.Prefix">
                Segmentación
            </NavLink>
        }
    }
</nav>

<div class="sidebar-user">
    <div class="avatar" aria-hidden="true">@Initials(CurrentUser.Name)</div>
    <div class="sidebar-user-copy">
        <span class="sidebar-user-name">@CurrentUser.Name</span>
        <span class="sidebar-user-role">@CurrentUser.RoleLabel</span>
    </div>
    <form method="post" action="/logout" class="sidebar-logout">
        <AntiforgeryToken />
        <button type="submit" class="nav-item nav-item-button" title="Cerrar sesión">Salir</button>
    </form>
</div>

@code {
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0
            ? "TF"
            : string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }
}
