@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="app-body">
        <header class="topbar">
            <div class="topbar-context">
                <span class="topbar-eyebrow">Tienda</span>
                <span class="topbar-store">@DemoSession.StoreName</span>
            </div>
            <div class="topbar-meta">
                <span class="topbar-date">@Formatters.LongDate(DateTime.UtcNow)</span>
                <span class="topbar-user">@DemoSession.UserName</span>
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">&times;</span>
</div>
