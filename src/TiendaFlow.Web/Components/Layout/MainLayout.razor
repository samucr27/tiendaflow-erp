@inherits LayoutComponentBase
@inject ICurrentUser CurrentUser

<div class="app-shell">
    <aside class="sidebar" id="app-sidebar">
        <NavMenu />
    </aside>

    <label class="nav-scrim" for="nav-drawer" aria-hidden="true"></label>

    <div class="app-body">
        <header class="topbar">
            <input id="nav-drawer"
                   class="nav-toggle-input"
                   type="checkbox"
                   aria-label="Abrir menú de navegación" />
            <label class="nav-toggle" for="nav-drawer" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </label>

            <div class="topbar-context">
                <span class="topbar-eyebrow">Tienda</span>
                <span class="topbar-store">@CurrentUser.StoreName</span>
            </div>
            <div class="topbar-meta">
                <span class="topbar-date">@Formatters.LongDate(DateTime.UtcNow)</span>
                <span class="topbar-user">@CurrentUser.Name</span>
                <span class="topbar-role">@CurrentUser.RoleLabel</span>
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">&times;</span>
</div>
