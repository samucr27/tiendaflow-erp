# Variables de entorno sin secretos para el entorno de Elastic Beanstalk.
# Los secretos (DB_CONNECTION_STRING, Seed__AdminPassword, Seed__DemoPassword)
# se escriben en la consola: Configuration > Updates, monitoring and logging >
# Environment properties. Nunca se guardan en este archivo.
option_settings:
  aws:elasticbeanstalk:application:environment:
    ASPNETCORE_ENVIRONMENT: Production
    # Carpeta escribible por el usuario "webapp" para las claves de las cookies.
    DataProtection__KeysPath: /var/app/tiendaflow-keys
    # El entorno de prueba de instancia única se sirve por HTTP (sin certificado).
    Authentication__RequireHttps: "false"
    # Primera publicación: crea el esquema en la base de RDS al arrancar.
    Database__MigrateOnStartup: "true"
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /healthz

# Se ejecutan como root en la carpeta de staging, antes de activar la versión.
container_commands:
  01_keys_folder:
    command: "mkdir -p /var/app/tiendaflow-keys && chown webapp:webapp /var/app/tiendaflow-keys && chmod 700 /var/app/tiendaflow-keys"
  02_executable:
    command: "chmod +x TiendaFlow.Web"
